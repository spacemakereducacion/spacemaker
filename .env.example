# Space Maker Educación — environment template
# Copy to .env and adjust. Never commit real secrets.

# Application
APP_NAME="Space Maker Educación"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL)
DATABASE_URL="postgresql://spacemaker:spacemaker_dev@localhost:5432/spacemaker?schema=public"

# Auth / sessions
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_SESSION_DAYS="7"

# Demo seed password (development only)
DEMO_PASSWORD="Demo.2026!"
DEMO_LOGIN="true"

# File storage
# local | s3 | r2 | supabase  (only "local" is implemented; others are adapters)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_PUBLIC_BASE_URL=

# Email (console adapter is used when SMTP is empty)
EMAIL_DRIVER="console"
SMTP_HOST=
SMTP_PORT="587"
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Space Maker Educación <no-reply@localhost>"

# Future channel adapters (not connected until credentials exist)
WHATSAPP_DRIVER="console"
SMS_DRIVER="console"
PUSH_DRIVER="console"

# Rate limiting
RATE_LIMIT_LOGIN_MAX="8"
RATE_LIMIT_LOGIN_WINDOW_SECONDS="300"

# Optional future SSO (adapters only; not enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
